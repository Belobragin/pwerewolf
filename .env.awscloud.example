#!/bin/bash

## project version
export VERSION=0.1.0
## debug level logging
export DEBUG=1
## actual timezone
export TZ=Europe/Belgrade
##  set logger level
export LOGGER_LEVEL=INFO

## server
export API_REST_PORT=8101
## cloud parameters
export AWS_RESOURCE_PREFIX=Werewolf
export AWS_RESOURCE_CFN_STACK_NAME=werewolf-bvv-cf-resource
export AWS_RESNET_CFN_STACK_NAME=crresnet-bvv-cf-resource
export AWS_PIPELINE_CFN_STACK_NAME=werewolf-bvv-cf-pipeline
export AWS_SQS_FOR_PROCESSING_CHAN=SqsQueueName
export AWS_SQS_RESULT_CHAN=SqsResultQueueName
export AWS_S3_BUCKET_RESOURCE=WerewolfProjectBucket
export AWS_BUCKET_STORAGE_PREFIX=storage
## metrics
export METRICS_PORT=8112
## cors
export USE_CORS=true
export ACCESS_CONTROL_MAX_AGE=3600
export ACCESS_CONTROL_ALLOW_ORIGIN="^https?://(localhost|127.0.0.1)(:[0-9]+)?$"
## picture max size
export MAX_IMAGE_SIZE=4Mb

## resnet50 lambda: the url comes from the crresnet stack, only the path is set here
export RESNET_PREDICT_PATH=/api/v1/predict

## folders
## upload source folder: key prefix inside the s3 bucket
export IMAGES_FOLDER=test-image
## go packages folder (go.mod folder) relative to project folder:
export GOFOLDER=bus
## swagger docs folder relative to go.mod folder (NOT relative to project folder)
export SWAG_OUTDIR=docs/apidoc
## downloads folder
export DOWNLOADS_CLOUDFOLDER=download
## objects storage placement
export IMAGE_STORAGE_FOLDER=image
export ADVERSARIAL_STORAGE_FOLDER=adversarial
export FILTER_STORAGE_FOLDER=filter
## store objects subfolders
export IMAGE_CLOUD_STORAGE=${AWS_BUCKET_STORAGE_PREFIX}/${IMAGE_STORAGE_FOLDER}
export ADVERSARIAL_CLOUD_STORAGE=${AWS_BUCKET_STORAGE_PREFIX}/${ADVERSARIAL_STORAGE_FOLDER}
export FILTER_CLOUD_STORAGE=${AWS_BUCKET_STORAGE_PREFIX}/${FILTER_STORAGE_FOLDER}
