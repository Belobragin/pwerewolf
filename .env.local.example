#!/bin/bash

## project version
export VERSION=1.0.0
## debug level logging
export DEBUG=1
## actual timezone
export TZ=Europe/Belgrade
##  set logger level
export LOGGER_LEVEL=INFO
## local api host
export API_HOST=0.0.0.0
export API_REST_PORT=8101
## postgres database settings
export POSTGRESQL_SSL_REQUIRED=false
export POSTGRESQL_SSLMODE_TYPE=
export POSTGRESQL_SSL_MODEL_DISABLE=disable
export METRICS_PORT=8112
export DB_DSN=
export DBCONNSTRING=postgresql://wf:[your-own-password]@[your-host-name]:5432/werewolf
export SERVICE_MAX_DB_CONN=10
## nats server
export NATS_PORT=4222
export NATS_METRIC_PORT=8222
export NATS_ADDRESS=127.0.0.1
## nats werewolf client settings
export NATS_WEREWOLF_NAME=control_panel
export NATS_WEREWOLF_USER=
export NATS_WEREWOLF_PSW=
## nats aker client settings
export NATS_AKER_NAME=
export NATS_AKER_USER=
export NATS_AKER_PSW=
## channel to exchange messages
export NATS_FOR_PROCESSING_CHAN=to_process_into_adv
export NATS_FROM_ALTERED_CHAN=get_adv_from_process
## these two lines are for broker client of werewolf app:
export NATS_CLIENT_NAME=control_panel
export BROKER_AUTH_NAME=
export BROKER_PSW=
## cors
export USE_CORS=true
export ACCESS_CONTROL_MAX_AGE=3600
export ACCESS_CONTROL_ALLOW_ORIGIN="^https?://(localhost|127.0.0.1)(:[0-9]+)?$"
## picture max size
export MAX_IMAGE_SIZE=4Mb

## resnet50 server parameters:
export RESNET_SERVER_HOST=localhost
export RESNET_SERVER_PORT=8005
export RESNET_PREDICT_PATH=/api/v1/predict

## folders
## base path of the project folder
export PROJECTFOLDER=
## relative to project folder
export LOCAL_IMAGES_FOLDER=test-image
## go packages folder (go.mod folder) relative to project folder:
export GOFOLDER=bus
## swagger docs folder relative to go.mod folder (NOT relative to project folder)
export SWAG_OUTDIR=docs/apidoc
## downloads folder
export DOWNLOADS_OBJECTS_FOLDER=download
## local storage folders
export LOCAL_STORAGE_FOLDER=local-storage
## objects storage placement
export IMAGE_STORAGE_FOLDER=image
export ADVERSARIAL_STORAGE_FOLDER=adversarial
export FILTER_STORAGE_FOLDER=filter
## store objects subfolders
## unquoted: .env.local is also parsed by `include` in the Makefile, which does not strip quotes
export IMAGE_LOCAL_STORAGE=${PROJECTFOLDER}/${LOCAL_STORAGE_FOLDER}/${IMAGE_STORAGE_FOLDER}
export ADVERSARIAL_LOCAL_STORAGE=${PROJECTFOLDER}/${LOCAL_STORAGE_FOLDER}/${ADVERSARIAL_STORAGE_FOLDER}
export FILTER_LOCAL_STORAGE=${PROJECTFOLDER}/${LOCAL_STORAGE_FOLDER}/${FILTER_STORAGE_FOLDER}
export DOWNLOADS_LOCAL_FOLDER=${PROJECTFOLDER}/${DOWNLOADS_OBJECTS_FOLDER}/local

